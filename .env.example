# ── Frontend (exposed to the browser via Vite) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (Vercel Serverless Functions / Vite dev middleware) ───────────
# Never prefix these with VITE_ — they must not reach the browser bundle.
GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides (defaults shown)
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# The server-side RAG lookup reuses the public Supabase URL/anon key. If you
# deploy where VITE_* vars are not available to functions, also set:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
